{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/commerce/**",
              "components/core/**",
              "components/feedback/**",
              "components/navigation/**",
              "ui_kits/menu-digital/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Gokart Bubble|Magic Clover|Newscrash|Baloo 2))/i]",
        "message": "Font not provided by the design system. Available: Gokart Bubble, Magic Clover, Newscrash, Baloo 2."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|secondary|neutral)$/]",
        "message": "<Badge> tone must be one of 'accent' | 'secondary' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|children|onClick|disabled|type|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, children, onClick, disabled, type."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|solidDark|solidPanel|pedidosya|brown|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'solidDark' | 'solidPanel' | 'pedidosya' | 'brown' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MascotGuide'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|pose|size|key|ref|className|style|children)$/]",
        "message": "<MascotGuide> doesn't accept that prop. Declared props: src, pose, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='MascotGuide'] > JSXAttribute[name.name='pose'] > Literal[value!=/^(?:eating|pointing)$/]",
        "message": "<MascotGuide> pose must be one of 'eating' | 'pointing'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MascotGuide'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:hero|accent)$/]",
        "message": "<MascotGuide> size must be one of 'hero' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Modal'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|onClose|title|children|ctaLabel|onCta|key|ref|className|style|children)$/]",
        "message": "<Modal> doesn't accept that prop. Declared props: open, onClose, title, children, ctaLabel, onCta."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|title|description|price|badge|key|ref|className|style|children)$/]",
        "message": "<ProductCard> doesn't accept that prop. Declared props: image, title, description, price, badge."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:tabs|active|onChange|key|ref|className|style|children)$/]",
        "message": "<TabNav> doesn't accept that prop. Declared props: tabs, active, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='ToppingTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|label|selected|onClick|key|ref|className|style|children)$/]",
        "message": "<ToppingTile> doesn't accept that prop. Declared props: image, label, selected, onClick."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
